{
  "manifest_version": 2,
  "name": "PHP Background Fetch Extension",
  "version": "1.0.0",
  "description": "Demo extension that calls a PHP endpoint from the background script to avoid CORS issues.",
  "permissions": [
    "http://www.dbooth.net/*",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "PHP Fetch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}